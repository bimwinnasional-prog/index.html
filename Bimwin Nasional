        async function terjemahkanTeksViaAPI(teksIndo, kodeBahasa) {
            if (!teksIndo || kodeBahasa === 'id') return teksIndo;
            const targetLang = kodeBahasa === 'jv' ? 'jw' : kodeBahasa;
            const blokParagraf = teksIndo.split(/\n+/).map(s => s.trim()).filter(Boolean);
            const hasilBlok = [];

            for (const paragraf of blokParagraf) {
                try {
                    const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=id&tl=${targetLang}&dt=t&q=${encodeURIComponent(paragraf)}`;
                    const res = await fetch(url);
                    const data = await res.json();
                    if (Array.isArray(data) && Array.isArray(data[0])) {
                        hasilBlok.push(data[0].map(x => x[0]).join(""));
                        continue;
                    }
                } catch (e) {}

                if (kodeBahasa === 'jv') {
                    hasilBlok.push(
                        paragraf
                            .replace(/Tujuan/gi, "Ancasipun")
                            .replace(/keluarga/gi, "kulawarga")
                            .replace(/perkawinan/gi, "palakrami")
                            .replace(/suami dan istri/gi, "garwa kakung lan putri")
                            .replace(/suami/gi, "garwa kakung")
                            .replace(/istri/gi, "garwa putri")
                            .replace(/anak/gi, "putra")
                            .replace(/disebut/gi, "dipunwastani")
                            .replace(/adalah/gi, "inggih punika")
                    );
                } else {
                    hasilBlok.push(paragraf);
                }
            }
            return hasilBlok.join("\n\n");
        }


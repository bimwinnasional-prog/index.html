        async function muatLogAktivitasAdmin() {
            const box = document.getElementById('list-audit-log');
            if (!box) return;
            try {
                const snap = await db.collection("audit_logs").get();
                semuaAuditLogCache = [];
                snap.forEach(doc => semuaAuditLogCache.push(doc.data()));
                semuaAuditLogCache.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
                filterLogAktivitasAdmin();
            } catch (e) {}
        }

        function filterLogAktivitasAdmin() {
            const box = document.getElementById('list-audit-log');
            if (!box) return;
            const tglMulai = document.getElementById('audit-tgl-mulai')?.value || '';
            const tglAkhir = document.getElementById('audit-tgl-akhir')?.value || '';

            const terfilter = semuaAuditLogCache.filter(l => {
                let tglItem = l.tanggalIso || '';
                if (!tglItem && l.timestamp) {
                    tglItem = new Date(l.timestamp).toISOString().slice(0, 10);
                }
                if (tglMulai && tglItem < tglMulai) return false;
                if (tglAkhir && tglItem > tglAkhir) return false;
                return true;
            });

            if (terfilter.length === 0) {
                box.innerHTML = `<p class="text-gray-400 italic">Tidak ada aktivitas admin pada rentang tanggal tersebut.</p>`;
                return;
            }
            box.innerHTML = terfilter.slice(0, 100).map(l =>
                `<div class="border-b dark:border-gray-700 pb-1">[${escapeHTML(l.waktu)}] <strong class="text-kemenag-teal">${escapeHTML(l.aktor)}:</strong> ${escapeHTML(l.aksi)}</div>`
            ).join('');
        }

        function resetFilterAuditLog() {
            const elMulai = document.getElementById('audit-tgl-mulai');
            const elAkhir = document.getElementById('audit-tgl-akhir');
            if (elMulai) elMulai.value = '';
            if (elAkhir) elAkhir.value = '';
            filterLogAktivitasAdmin();
        }


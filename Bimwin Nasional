            if (!currentUser || currentUser.role.toLowerCase() !== 'peserta') return;
            if (unsubscribeNotifAPKPeserta) unsubscribeNotifAPKPeserta();

            const keyTerakhirBaca = `bimwin_notif_read_${currentUser.username}`;
            unsubscribeNotifAPKPeserta = db.collection("notifikasi_apk").onSnapshot(snap => {
                let waktuTerakhirBaca = 0;
                try { waktuTerakhirBaca = parseInt(localStorage.getItem(keyTerakhirBaca) || "0", 10); } catch (e) {}
                const cocokUntukSaya = [];
                const belumLulusSaya = (modulAktifGlobal <= getIdModulMaksimal()) || !currentUser.pasanganUsername || (currentUser.skorPostest === null);

                snap.forEach(doc => {
                    const d = doc.data();
                    let relevan = false;
                    const cocokWilayahKua = (!d.targetKua || d.targetKua === 'Semua' || d.targetKua === currentUser.kua);
                    if (d.tipeTarget === 'semua_peserta' && cocokWilayahKua) relevan = true;
                    else if (d.tipeTarget === 'belum_lulus' && belumLulusSaya && cocokWilayahKua) relevan = true;
                    else if (d.tipeTarget === 'per_kua' && d.targetKua === currentUser.kua) relevan = true;
                    else if (d.tipeTarget === 'per_username' && d.targetUsername === currentUser.username) relevan = true;

                    if (relevan) cocokUntukSaya.push({ id: doc.id, ...d });
                });

                cocokUntukSaya.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
                daftarNotifAPKPesertaCache = cocokUntukSaya;

                const belumDibaca = cocokUntukSaya.filter(n => (n.timestamp || 0) > waktuTerakhirBaca);
                const badgeAngka = document.getElementById('badge-angka-notif-apk');
                if (badgeAngka) {
                    if (belumDibaca.length > 0) {
                        badgeAngka.innerText = belumDibaca.length;
                        badgeAngka.classList.remove('hidden');
                    } else {
                        badgeAngka.classList.add('hidden');
                    }
                }

                if (belumDibaca.length > 0) {
                    const terbaru = belumDibaca[0];
                    const keySudahPop = `bimwin_pop_${terbaru.id}_${currentUser.username}`;
                    let sudahPop = false;
                    try { sudahPop = !!sessionStorage.getItem(keySudahPop); } catch (e) {}
                    if (!sudahPop) {
                        try { sessionStorage.setItem(keySudahPop, "1"); } catch (e) {}

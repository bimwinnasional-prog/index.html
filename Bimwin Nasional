        async function handleLogin(e) {
            if(e) e.preventDefault();
            document.getElementById('login-error').classList.add('hidden');
            const btn = document.getElementById('btn-login'); btn.innerHTML = 'Memverifikasi...';
            const username = document.getElementById('username').value.trim().toLowerCase();
            const password = document.getElementById('password').value.trim();

            try {
                const sysDoc = await db.collection("system_settings").doc("main").get();
                if (sysDoc.exists) {
                    statusMaintenanceGlobal = !!sysDoc.data().maintenanceMode;
                }

                const doc = await db.collection("users").doc(username).get();
                if (!doc.exists) {
                    document.getElementById('login-error').innerText = "Username atau password salah.";
                    document.getElementById('login-error').classList.remove('hidden');
                    btn.innerHTML = 'Masuk'; return;
                }
                const userData = doc.data();
                const inputHash = await hashPasswordSHA256(password);
                const cocokHash = userData.passwordHash && (userData.passwordHash === inputHash);
                const cocokPolos = userData.password === password;

                if (!cocokHash && !cocokPolos) {
                    document.getElementById('login-error').innerText = "Username atau password salah.";
                    document.getElementById('login-error').classList.remove('hidden');
                    btn.innerHTML = 'Masuk'; return;
                }

                if (!userData.passwordHash && cocokPolos) {
                    await db.collection("users").doc(username).set({ passwordHash: inputHash }, { merge: true });
                }

                if (statusMaintenanceGlobal && userData.role !== 'SuperAdmin') {
                    document.getElementById('login-error').innerText = "Sistem sedang dalam Pemeliharaan Rutin. Saat ini yang dapat masuk hanya Admin Kemenag (SuperAdmin).";
                    document.getElementById('login-error').classList.remove('hidden');
                    document.getElementById('maintenance-overlay').classList.remove('hidden');
                    btn.innerHTML = 'Masuk';
                    return;
                }

                await muatProfilLengkapDanMasuk(userData, true);
            } catch (err) {
                document.getElementById('login-error').innerText = "Koneksi gagal: " + err.message;
                document.getElementById('login-error').classList.remove('hidden');
            } finally { btn.innerHTML = 'Masuk'; }
        }

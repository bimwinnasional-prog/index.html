                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
                        </span>
                        <span>Sistem Online</span>
                    </div>
                    <button id="btn-install-pwa" onclick="installAplikasiPWA()" class="hidden bg-kemenag-gold hover:bg-yellow-400 text-gray-900 font-extrabold px-2.5 py-0.5 rounded-full text-[10px] shadow items-center gap-1 transition">
                        <i class="fas fa-download text-[9px]"></i> <span>Install App</span>
                    </button>
                </div>

                <div class="flex items-center gap-2 ml-auto">
                    <button id="btn-lonceng-notif-peserta" onclick="bukaModalKotakMasukNotifAPK()" class="hidden relative bg-white/10 hover:bg-white/20 text-white px-2.5 py-0.5 rounded-full text-[10px] font-bold items-center gap-1 border border-white/20 transition" title="Kotak Masuk Pengingat">

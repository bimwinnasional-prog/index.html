                    <i class="fas fa-book-open text-teal-600 w-5 text-center shrink-0"></i> <span class="text-left">Panduan Aplikasi</span>
                </button>
                <button type="button" onclick="bukaSeksiBerandaUtama('seksi-utama-informasi')" class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold hover:bg-emerald-50 dark:hover:bg-gray-700 flex items-center justify-start gap-2.5 transition">
                    <i class="fas fa-chart-pie text-emerald-600 w-5 text-center shrink-0"></i> <span class="text-left">Informasi</span>
                </button>
                <button type="button" onclick="bukaSeksiBerandaUtama('seksi-utama-direktori')" class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold hover:bg-emerald-50 dark:hover:bg-gray-700 flex items-center justify-start gap-2.5 transition">
                    <i class="fas fa-map-marked-alt text-kemenag-gold w-5 text-center shrink-0"></i> <span class="text-left">Direktori KUA</span>
                </button>
                <button type="button" onclick="bukaSeksiBerandaUtama('seksi-utama-galeri')" class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold hover:bg-emerald-50 dark:hover:bg-gray-700 flex items-center justify-start gap-2.5 transition">
                    <i class="fas fa-images text-emerald-600 w-5 text-center shrink-0"></i> <span class="text-left">Galeri</span>
                </button>
                <button type="button" onclick="bukaSeksiBerandaUtama('seksi-utama-faq')" class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold hover:bg-emerald-50 dark:hover:bg-gray-700 flex items-center justify-start gap-2.5 transition">
                    <i class="fas fa-question-circle text-amber-500 w-5 text-center shrink-0"></i> <span class="text-left">FAQ</span>
                </button>
                <button type="button" onclick="tutupSemuaHamburgerMenu(); bukaModalKritik()" class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold hover:bg-emerald-50 dark:hover:bg-gray-700 flex items-center justify-start gap-2.5 transition">
                    <i class="fas fa-comment-dots text-amber-500 w-5 text-center shrink-0"></i> <span class="text-left">Kritik &amp; Saran</span>
                </button>
            </div>
        </div>

        <div id="banner-running-text" class="bg-amber-50 dark:bg-gray-800 border border-amber-300 dark:border-gray-700 rounded-2xl py-2 px-3.5 overflow-hidden flex items-center gap-2.5 text-xs sm:text-sm shadow-sm">
            <span class="bg-kemenag-teal text-white font-extrabold px-2.5 py-0.5 rounded-full text-[10px] shrink-0 flex items-center gap-1 shadow">
                <i class="fas fa-bullhorn text-kemenag-gold"></i> INFO
            </span>
            <div class="overflow-hidden w-full relative">
                <div id="teks-pengumuman-berjalan" class="animate-marquee-Announcement font-semibold text-gray-800 dark:text-gray-200">
                    Selamat Datang di Platform Bimwin Mandiri Kemenag RI • Alur Wajib 8 Langkah: 1. Wajib Sinkron Pasangan → 2. Pretest (5 Soal) → 3. 5 Modul &amp; Kuis → 4. Postest (5 Soal) → 5. Klik Menu SELESAI → 6. Survei Kepuasan Masyarakat (IKM) → 7. Memilih Salah Satu Kelas (Online/Offline) untuk Verifikasi Fasilitator → 8. Download Sertifikat (PDF), Piagam Kami Kompak, Portofolio Catin (PDF) &amp; Kartu Story WA/IG/TikTok.
                </div>
            </div>
        </div>

        <div id="seksi-utama-informasi" class="hidden bg-white dark:bg-gray-800 p-5 sm:p-6 rounded-2xl shadow-md border-2 border-kemenag-teal space-y-5">
            <div class="flex justify-between items-center border-b dark:border-gray-700 pb-2.5">
                <h2 class="text-base sm:text-xl font-extrabold text-kemenag-teal dark:text-emerald-400 flex items-center gap-2">

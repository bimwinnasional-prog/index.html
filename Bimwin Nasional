        function validasiDanKompresFotoProfil(fileInput, imgPreviewId) {
            const file = fileInput.files && fileInput.files[0];
            if (!file) return;

            const tipeValid = ['image/jpeg', 'image/jpg', 'image/png'];
            const namaFile = (file.name || '').toLowerCase();
            const ekstensiValid = namaFile.endsWith('.jpg') || namaFile.endsWith('.jpeg') || namaFile.endsWith('.png');

            if (!tipeValid.includes(file.type) && !ekstensiValid) {
                fileInput.value = '';
                return alert("Format file tidak didukung! Wajib menggunakan format JPG, JPEG, atau PNG.");
            }

            const batasMaksimalBytes = 2 * 1024 * 1024;
            if (file.size > batasMaksimalBytes) {
                fileInput.value = '';
                const ukuranMb = (file.size / (1024 * 1024)).toFixed(2);
                return alert(`Ukuran file foto terlalu besar (${ukuranMb} MB)! Ukuran maksimal yang diizinkan adalah 2 MB.`);
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const maxDim = 420;
                    let w = img.width;
                    let h = img.height;
                    if (w > h && w > maxDim) {
                        h = Math.round((h * maxDim) / w);
                        w = maxDim;
                    } else if (h > maxDim) {
                        w = Math.round((w * maxDim) / h);
                        h = maxDim;
                    }
                    canvas.width = w;
                    canvas.height = h;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, w, h);
                    const dataUrlKompres = canvas.toDataURL('image/jpeg', 0.86);
                    const elPrev = document.getElementById(imgPreviewId);
                    if (elPrev) elPrev.src = dataUrlKompres;
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function previewFoto(event) {

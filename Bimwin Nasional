                        <div class="${isKecocokan ? '' : 'sm:col-span-3'}"><label class="block text-[11px] font-bold text-gray-500">Pilihan Jawaban / Opsi Sikap (Pisahkan dengan <b>|</b> ):</label><input type="text" value="${escapeHTML(opsiGabung)}" oninput="ubahOpsiSoalAdmin(${idx}, this.value)" class="w-full px-2.5 py-1.5 border rounded-lg bg-gray-50 dark:bg-gray-900 text-xs font-mono outline-none"></div>
                        ${isKecocokan ? '' : `<div><label class="block text-[11px] font-bold text-gray-500">Kunci Jawaban:</label><select onchange="kuisEditorSementara[${idx}].ans = parseInt(this.value, 10)" class="w-full px-2.5 py-1.5 border rounded-lg bg-emerald-50 dark:bg-gray-900 text-xs font-bold text-kemenag-teal outline-none">${(item.opt || []).map((o, oIdx) => `<option value="${oIdx}" ${item.ans === oIdx ? 'selected' : ''}>Opsi ${oIdx + 1}: ${escapeHTML(o.substring(0, 15))}</option>`).join('')}</select></div>`}

                        if (!currentUser.kompakPeran && uPas.kompakPeran) {
                            document.getElementById('kompak-peran').value = uPas.kompakPeran;
                            document.getElementById('kompak-keuangan').value = uPas.kompakKeuangan || '';
                            document.getElementById('kompak-pola-asuh').value = uPas.kompakPolaAsuh || '';

                        <span class="hidden sm:inline">Pengingat</span>
                        <span id="badge-angka-notif-apk" class="hidden bg-red-600 text-white text-[9px] font-black px-1.5 py-0.2 rounded-full border border-white animate-bounce">0</span>
                    </button>

                    <div id="nav-menu" class="hidden flex items-center gap-2">

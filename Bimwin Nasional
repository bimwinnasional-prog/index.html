        function pilihSuaraTerbaikPerangkat(kodeBahasa) {
            if (!('speechSynthesis' in window)) return null;
            const voices = window.speechSynthesis.getVoices() || [];
            if (voices.length === 0) return null;

            const targetPrefixes = {
                id: ['id-ID', 'id_', 'id', 'ms-MY'],
                jv: ['jv-ID', 'jw-ID', 'id-ID', 'id'],
                en: ['en-US', 'en-GB', 'en_US', 'en'],
                ar: ['ar-SA', 'ar-EG', 'ar-AE', 'ar']
            }[kodeBahasa] || ['id-ID'];

            for (const pref of targetPrefixes) {
                const found = voices.find(v => (v.lang || '').toLowerCase().startsWith(pref.toLowerCase()));
                if (found) return found;
            }
            return null;
        }

        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = () => { window.speechSynthesis.getVoices(); };
        }

        function pecahKalimatUntukTTS(teks) {
            const bersih = (teks || "").replace(/\s+/g, " ").trim();
            if (!bersih) return [];
            const potongan = bersih.match(/[^.!?।،\n]+[.!?।،\n]?/g) || [bersih];
            const hasil = [];
            let sementara = "";
            potongan.forEach(kal => {
                if ((sementara + " " + kal).trim().length <= 165) {
                    sementara = (sementara + " " + kal).trim();
                } else {
                    if (sementara) hasil.push(sementara);
                    sementara = kal.trim();
                }
            });
            if (sementara) hasil.push(sementara);
            return hasil;
        }

        function hentikanSuaraTTS() {
            antreanTeksTTS = [];
            if ('speechSynthesis' in window) {
                try { window.speechSynthesis.cancel(); } catch (e) {}
            }
            if (objekAudioFallbackTTS) {
                try { objekAudioFallbackTTS.pause(); objekAudioFallbackTTS = null; } catch (e) {}
            }
            setIndikatorTombolTTSAktif(false);
        }

        function bacakanTeksSuaraMultiBahasa(teksMentah, kodeBahasa = 'id') {
            hentikanSuaraTTS();
            const daftarPotongan = pecahKalimatUntukTTS(teksMentah);
            if (daftarPotongan.length === 0) return;

            antreanTeksTTS = [...daftarPotongan];
            setIndikatorTombolTTSAktif(true);

            const mapLangTag = { id: "id-ID", jv: "id-ID", en: "en-US", ar: "ar-SA" };
            const suaraTerpilih = pilihSuaraTerbaikPerangkat(kodeBahasa);

            function putarPotonganBerikutnya() {
                if (antreanTeksTTS.length === 0) {
                    setIndikatorTombolTTSAktif(false);
                    return;
                }
                const kalimat = antreanTeksTTS.shift();
                if ('speechSynthesis' in window) {
                    const utter = new SpeechSynthesisUtterance(kalimat);
                    utter.lang = suaraTerpilih ? suaraTerpilih.lang : (mapLangTag[kodeBahasa] || "id-ID");
                    if (suaraTerpilih) utter.voice = suaraTerpilih;
                    utter.rate = kodeBahasa === 'ar' ? 0.92 : 0.97;
                    utter.pitch = 1.0;
                    utter.onend = () => putarPotonganBerikutnya();
                    utter.onerror = () => putarPotonganBerikutnya();
                    window.speechSynthesis.speak(utter);
                } else {
                    setIndikatorTombolTTSAktif(false);
                }
            }

            putarPotonganBerikutnya();
        }


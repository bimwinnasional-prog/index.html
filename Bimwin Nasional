        async function simpanEditPeserta(e) {
            e.preventDefault();
            const usernameLama = document.getElementById('edit-username-lama').value.trim();
            const usernameBaru = document.getElementById('edit-username-baru').value.trim().toLowerCase();
            const passwordBaru = document.getElementById('edit-password-baru').value.trim();
            const nama = document.getElementById('edit-nama').value.trim();
            const email = document.getElementById('edit-email').value.trim();
            const nik = document.getElementById('edit-nik').value.trim();
            const kua = document.getElementById('edit-kua').value;
            const pasanganUnameBaru = document.getElementById('edit-pasangan-username').value.trim().toLowerCase();
            const alamat = document.getElementById('edit-alamat').value.trim();

            try {
                const userDocLama = await db.collection("users").doc(usernameLama).get();
                const dataLama = userDocLama.data();
                const pasanganUnameLama = dataLama.pasanganUsername || '';
                const passHash = await hashPasswordSHA256(passwordBaru);

                let namaPasanganBaru = dataLama.pasanganNama || '';
                if (pasanganUnameBaru !== pasanganUnameLama) {
                    if (pasanganUnameLama) {
                        const oldPasRef = db.collection("users").doc(pasanganUnameLama);
                        const oldPasSnap = await oldPasRef.get();
                        if (oldPasSnap.exists && oldPasSnap.data().pasanganUsername === usernameLama) {
                            await oldPasRef.set({ pasanganUsername: "", pasanganNama: "" }, { merge: true });
                        }
                    }
                    if (pasanganUnameBaru) {
                        const newPasRef = db.collection("users").doc(pasanganUnameBaru);
                        const newPasSnap = await newPasRef.get();
                        if (newPasSnap.exists) {
                            namaPasanganBaru = newPasSnap.data().nama || pasanganUnameBaru;
                            await newPasRef.set({ pasanganUsername: usernameBaru, pasanganNama: nama }, { merge: true });
                        }
                    } else {
                        namaPasanganBaru = '';
                    }
                } else if (pasanganUnameBaru) {
                    const pasRef = db.collection("users").doc(pasanganUnameBaru);
                    const pasSnap = await pasRef.get();
                    if (pasSnap.exists) {
                        await pasRef.set({ pasanganUsername: usernameBaru, pasanganNama: nama }, { merge: true });
                    }
                }

                if (usernameBaru !== usernameLama) {
                    if ((await db.collection("users").doc(usernameBaru).get()).exists) return alert("Username sudah dipakai!");
                    await db.collection("users").doc(usernameBaru).set({
                        ...dataLama,
                        username: usernameBaru, password: passwordBaru, passwordHash: passHash,
                        nama, email, nik, kua, alamat,
                        pasanganUsername: pasanganUnameBaru, pasanganNama: namaPasanganBaru
                    });
                    const progDocLama = await db.collection("progress").doc(usernameLama).get();
                    if (progDocLama.exists) {
                        await db.collection("progress").doc(usernameBaru).set({ ...progDocLama.data(), username: usernameBaru });
                        await db.collection("progress").doc(usernameLama).delete();
                    }
                    await db.collection("users").doc(usernameLama).delete();
                } else {
                    await db.collection("users").doc(usernameLama).update({
                        password: passwordBaru, passwordHash: passHash,
                        nama, email, nik, kua, alamat,
                        pasanganUsername: pasanganUnameBaru, pasanganNama: namaPasanganBaru
                    });
                }
                catatLogAktivitasAdmin(`Mengedit data peserta: ${nama} (${usernameBaru})`);
                tutupModalEditPeserta(); alert("Data & kredensial peserta berhasil diperbarui!"); loadDataAdmin(currentUser);
            } catch (err) { alert("Error: " + err.message); }
        }

        async function hapusPeserta(username) {
            if (!confirm(`Hapus peserta "${username}"?`)) return;
            try {
                const uDoc = await db.collection("users").doc(username).get();
                if (uDoc.exists) {
                    const pasUname = uDoc.data().pasanganUsername;
                    if (pasUname) {
                        const pasRef = db.collection("users").doc(pasUname);
                        const pasSnap = await pasRef.get();
                        if (pasSnap.exists && pasSnap.data().pasanganUsername === username) {
                            await pasRef.set({ pasanganUsername: "", pasanganNama: "" }, { merge: true });
                        }
                    }
                }
                await db.collection("users").doc(username).delete();
                await db.collection("progress").doc(username).delete();
                catatLogAktivitasAdmin(`Menghapus akun peserta: ${username}`);
                loadDataAdmin(currentUser);
            } catch (err) {
                alert("Gagal menghapus peserta: " + err.message);
            }
        }


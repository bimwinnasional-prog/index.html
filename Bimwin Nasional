                if (savedUname && !currentUser) {
                    const docSnap = await db.collection("users").doc(savedUname).get();
                    if (docSnap.exists) {
                        const uData = docSnap.data();
                        if (!statusMaintenanceGlobal || uData.role === 'SuperAdmin') {
                            await muatProfilLengkapDanMasuk(uData, false);
                        }
                    }
                }
            } catch (e) {}
        });

        async function eksporDatabaseCadangan(format) {
            const usersSnap = await db.collection("users").get();
            const progSnap = await db.collection("progress").get();
            const kritikSnap = await db.collection("kritik_saran").get();
            const dataBackup = { users: [], progress: [], kritik_saran: [] };
            usersSnap.forEach(d => dataBackup.users.push(d.data()));
            progSnap.forEach(d => dataBackup.progress.push(d.data()));
            kritikSnap.forEach(d => dataBackup.kritik_saran.push(d.data()));

            if (format === 'json') {
                const blob = new Blob([JSON.stringify(dataBackup, null, 2)], { type: "application/json" });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `Backup_Firestore_Bimwin_${new Date().toISOString().slice(0,10)}.json`;
                a.click();

        function bunyikanNadaNotifLembut() {
            try {
                const ctxAudio = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctxAudio.createOscillator();
                const gain = ctxAudio.createGain();
                osc.type = "sine";
                osc.frequency.setValueAtTime(880, ctxAudio.currentTime);
                gain.gain.setValueAtTime(0.08, ctxAudio.currentTime);
                osc.connect(gain);
                gain.connect(ctxAudio.destination);
                osc.start();
                osc.stop(ctxAudio.currentTime + 0.25);
            } catch (e) {}
        }

        function sinkronkanKonteksPushServiceWorker() {
            try {
                const uname = localStorage.getItem("bimwin_active_peserta_uname") || "";
                const kua = localStorage.getItem("bimwin_active_peserta_kua") || "";
                const lastRead = parseInt(localStorage.getItem(`bimwin_notif_read_${uname}`) || "0", 10);
                if ('serviceWorker' in navigator && navigator.serviceWorker.controller) {
                    navigator.serviceWorker.controller.postMessage({
                        type: 'SET_USER_PUSH_CONTEXT',
                        username: uname,
                        kua: kua,
                        lastSeenTs: lastRead
                    });
                }
            } catch (e) {}
        }


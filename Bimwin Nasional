        async function tampilkanHasilKuis() {
            document.getElementById('hasil-modal').classList.remove('hidden');
            document.getElementById('nilai-akhir').innerText = `${jawabanBenar}/${kuisAktif.length}`;

            if (idModulAktif === 91 || idModulAktif === 92) {
                const isPre = idModulAktif === 91;
                const skorSkala100 = Math.round((jawabanBenar / kuisAktif.length) * 100);
                document.getElementById('ikon-hasil').className = "fas fa-clipboard-check text-5xl sm:text-6xl text-amber-500 mb-3";
                document.getElementById('judul-hasil').innerText = isPre ? "Latihan Pretest Selesai!" : "Evaluasi Postest Selesai!";
                document.getElementById('pesan-hasil').innerText = isPre
                    ? `Skor Pretest Anda: ${skorSkala100}/100. Modul 1 sekarang telah terbuka, silakan mulai belajar secara berurutan!`
                    : `Skor Evaluasi Postest Anda: ${skorSkala100}/100. Silakan klik tombol "SELESAI" di Dasbor, isi Survei IKM, lalu pilih salah satu kelas (Online/Offline) untuk mendapatkan verifikasi Fasilitator!`;
                try {
                    const fieldUpdate = isPre ? { skorPretest: skorSkala100 } : { skorPostest: skorSkala100 };
                    await db.collection("progress").doc(currentUser.username).set(fieldUpdate, { merge: true });
                    if (isPre) {
                        currentUser.skorPretest = skorSkala100;
                        if (modulAktifGlobal < 1) modulAktifGlobal = 1;
                    } else {
                        currentUser.skorPostest = skorSkala100;
                    }
                    renderKartuModul();
                    perbaruiStatusBadgePeserta();
                    muatStatusPasanganDanRaporBeforeAfter();
                } catch (e) {}
                return;
            }

            const syaratLulus = Math.ceil(kuisAktif.length * 0.8);
            if (jawabanBenar >= syaratLulus) {
                const idsUrut = getIdsModulAktif();
                const posSekarang = idsUrut.indexOf(idModulAktif);
                const idSelanjutnya = (posSekarang >= 0 && posSekarang + 1 < idsUrut.length) ? idsUrut[posSekarang + 1] : (getIdModulMaksimal() + 1);
                let modulBaru = Math.max(modulAktifGlobal, idSelanjutnya);

                document.getElementById('ikon-hasil').className = "fas fa-award text-5xl sm:text-6xl text-green-500 mb-3";
                document.getElementById('judul-hasil').innerText = "Selamat! Anda Lulus Kuis";
                document.getElementById('pesan-hasil').innerText = modulBaru > getIdModulMaksimal()
                    ? "Seluruh Modul telah selesai! Silakan lanjutkan mengerjakan Evaluasi Postest (5 Soal)."
                    : "Standar kelulusan tercapai. Modul berikutnya telah terbuka!";

                try {
                    const progRef = db.collection("progress").doc(currentUser.username);
                    const progSnap = await progRef.get();
                    const dataProg = progSnap.exists ? progSnap.data() : {};
                    const nilaiLamaModul = Math.min(kuisAktif.length, dataProg[`nilai_m${idModulAktif}`] || 0);
                    const nilaiTerbaikModul = Math.max(nilaiLamaModul, jawabanBenar);

                    let totalBenarSemua = 0;
                    let totalSoalSemua = 0;
                    idsUrut.forEach(mId => {
                        const jmlSoalM = dbKuis[mId] ? dbKuis[mId].length : 5;
                        const skorTersimpan = Math.min(jmlSoalM, dataProg[`nilai_m${mId}`] || 0);
                        const skorM = (mId === idModulAktif) ? nilaiTerbaikModul : skorTersimpan;
                        totalBenarSemua += skorM;
                        totalSoalSemua += jmlSoalM;
                    });
                    totalNilaiGlobal = totalSoalSemua > 0 ? Math.min(100, Math.round((totalBenarSemua / totalSoalSemua) * 100)) : 0;

                    await progRef.set({
                        username: currentUser.username,
                        modulAktif: modulBaru,
                        [`nilai_m${idModulAktif}`]: nilaiTerbaikModul,
                        totalNilai: totalNilaiGlobal
                    }, { merge: true });

                    modulAktifGlobal = modulBaru;
                    currentUser.modulAktif = modulBaru;
                    currentUser.totalNilai = totalNilaiGlobal;
                    renderKartuModul();
                    perbaruiStatusBadgePeserta();
                    muatStatusPasanganDanRaporBeforeAfter();
                } catch (err) {}
            } else {
                document.getElementById('ikon-hasil').className = "fas fa-times-circle text-5xl sm:text-6xl text-red-500 mb-3";
                document.getElementById('judul-hasil').innerText = "Belum Lulus Kuis";
                document.getElementById('pesan-hasil').innerText = `Anda menjawab ${jawabanBenar} benar dari ${kuisAktif.length} soal. Minimal ${syaratLulus} benar untuk lulus. Silakan ulangi kembali.`;
            }
        }

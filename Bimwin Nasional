    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>

    <script>
        tailwind.config = { 
            darkMode: 'class',
            theme: { extend: { colors: { kemenag: { teal: '#0b6623', gold: '#FFB800', yellow: '#FFD700', darkteal: '#064414', bg: '#F4F7F6' } } } } 
        }
    </script>
    <style>
        body, html {
            background-color: #F4F7F6 !important; margin: 0 !important; padding: 0 !important;
            width: 100% !important; min-height: 100vh !important; overflow-x: hidden; -webkit-text-size-adjust: 100%;
        }
        .dark body, .dark html { background-color: #111827 !important; }
        @media screen and (max-width: 640px) {
            input, select, textarea { font-size: 16px !important; }
        }
        .table-container { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .quiz-option.selected { border-color: #0b6623; background-color: rgba(11, 102, 35, 0.08); font-weight: 700; }

        .hologram-watermark {
            position: absolute; inset: 0; pointer-events: none; z-index: 20;
            background: repeating-linear-gradient(
                -35deg,
                rgba(11, 102, 35, 0.04) 0px,
                rgba(11, 102, 35, 0.04) 28px,
                rgba(255, 184, 0, 0.05) 28px,
                rgba(255, 184, 0, 0.05) 56px
            );
            display: flex; align-items: center; justify-content: center; overflow: hidden;
        }
        .hologram-watermark::after {
            content: "DOKUMEN SAH KEMENAG RI • TERVERIFIKASI DIGITAL";
            font-size: 24pt; font-weight: 900; letter-spacing: 4px; color: rgba(11, 102, 35, 0.075);
            transform: rotate(-22deg); white-space: nowrap; border: 3px dashed rgba(255, 184, 0, 0.22);
            padding: 12px 28px; border-radius: 16px;
        }

        @keyframes marqueeRun {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }
        .animate-marquee-Announcement {
            display: inline-block; white-space: nowrap; animation: marqueeRun 30s linear infinite;
        }
        .animate-marquee-Announcement:hover { animation-play-state: paused; }

        .pdf-render-stage {
            position: fixed !important; left: 0 !important; top: 0 !important; z-index: 99999 !important;
            background: rgba(0, 0, 0, 0.85) !important; width: 100vw !important; height: 100vh !important;
            overflow: auto !important; display: flex !important; align-items: center !important;
            justify-content: center !important; padding: 16px !important;
        }

        #container-cetak-absen-offline tr, #pdf-export-container tr {
            page-break-inside: avoid !important; break-inside: avoid !important;
        }
        #container-cetak-absen-offline thead, #pdf-export-container thead {
            display: table-header-group !important;
        }
        @media print {
            @page { margin: 8mm; }
            body { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 antialiased min-h-screen flex flex-col transition-colors duration-300">

    <!-- HEADER PROFESIONAL RATA KIRI + TOMBOL MODE GELAP/TERANG SEJAJAR + SUB-BAR ONLINE/OFFLINE -->
    <header class="bg-gradient-to-r from-[#04330e] via-[#0b6623] to-[#064e1b] text-white shadow-2xl sticky top-0 z-40 border-b-[3px] border-kemenag-gold">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 md:px-8 pt-2.5 pb-2 flex items-center justify-between gap-2.5 sm:gap-4">
            <div class="flex items-center gap-2.5 sm:gap-3.5 min-w-0 flex-1">
                <div class="w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-white p-1 shadow-[0_0_15px_rgba(255,184,0,0.45)] border-2 border-kemenag-gold ring-2 ring-white/20 flex items-center justify-center shrink-0">
                    <img class="logo-kemenag-img w-full h-full object-contain" alt="Logo Kemenag" src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgSFAkl-T9vjVO3h8hbEexC4Mg7kbSzGiBzrU5jbH9A_acXifuIcuoLuK-Neb7rhWk7bymCZ20R4rGM3R9dzoNAe7_Ahkm5tA6Hed7bL5KQ5Lxve1Ow1lgVKGWXf3MTBeMstf5IeSz0jUGYbkWKooqfToliNuEuZVkm6wDb3BaglVmKmJt37ujwYYrXFor_/s320/logo-kementerian-agama-kemenag-removebg-preview.png" onerror="this.onerror=null;this.src=window.LOGO_KEMENAG_FALLBACK;"/>
                </div>
                <div class="min-w-0 flex-1 text-left">
                    <h1 id="header-judul-utama" class="font-black text-[13.5px] sm:text-xl md:text-2xl uppercase tracking-wide text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.35)] leading-tight truncate">
                        BIMWIN KEMENAG JEPARA
                    </h1>
                    <p class="text-[9.5px] sm:text-xs md:text-sm text-kemenag-yellow font-bold mt-0.5 whitespace-nowrap overflow-hidden text-ellipsis leading-tight">
                        "Kenali Diri, Pahami Pasangan, Siapkan Pernikahan."
                    </p>
                </div>
            </div>

            <div class="flex items-center justify-end shrink-0">
                <button onclick="toggleDarkMode()" class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 backdrop-blur-md border border-white/25 shadow-md flex items-center justify-center transition-all duration-200 group" title="Ganti Mode Terang / Gelap">
                    <i id="dark-icon-mob" class="fas fa-moon text-kemenag-gold text-sm sm:text-base group-hover:rotate-12 transition-transform"></i>
                </button>
            </div>
        </div>

        <div class="bg-black/25 backdrop-blur-sm border-t border-white/10 px-3 sm:px-6 md:px-8 py-1.5">
            <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <div id="indikator-koneksi-net" class="inline-flex items-center gap-1.5 bg-emerald-950/80 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold text-emerald-300 border border-emerald-400/30 shadow-inner" title="Status Jaringan Real-Time">

        function acakSoalDanOpsiKuis(daftarSoalAsli) {
            const salinan = JSON.parse(JSON.stringify(daftarSoalAsli || []));
            for (let i = salinan.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [salinan[i], salinan[j]] = [salinan[j], salinan[i]];
            }
            return salinan.map(soal => {
                const teksJawabanBenar = soal.opt[soal.ans];
                const opsiAcak = [...soal.opt];
                for (let i = opsiAcak.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [opsiAcak[i], opsiAcak[j]] = [opsiAcak[j], opsiAcak[i]];
                }
                return {
                    q: soal.q,
                    opt: opsiAcak,
                    ans: Math.max(0, opsiAcak.indexOf(teksJawabanBenar))
                };
            });
        }

        function mulaiKuis(idModul) {

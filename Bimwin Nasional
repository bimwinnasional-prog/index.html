        async function muatStatusPasanganDanRaporBeforeAfter() {
            if (!currentUser) return;

            const pre = currentUser.skorPretest;
            const post = currentUser.skorPostest;
            const elPre = document.getElementById('rapor-skor-pretest');
            const elPost = document.getElementById('rapor-skor-postest');
            const elGain = document.getElementById('rapor-kenaikan-skor');
            const badgeGain = document.getElementById('badge-selisih-before-after');
            const teksAnalisis = document.getElementById('teks-analisis-before-after');

            if (elPre) elPre.innerText = (pre !== null && pre !== undefined) ? `${pre}` : '-';
            if (elPost) elPost.innerText = (post !== null && post !== undefined) ? `${post}` : '-';

            if (pre !== null && pre !== undefined && post !== null && post !== undefined) {
                const selisih = post - pre;
                const tanda = selisih >= 0 ? `+${selisih}` : `${selisih}`;
                if (elGain) elGain.innerText = `${tanda} Poin`;
                if (badgeGain) {
                    badgeGain.innerText = selisih >= 0 ? `Meningkat ${tanda} Poin ✓` : `Selisih ${tanda} Poin`;
                    badgeGain.className = "text-[11px] font-black bg-emerald-600 text-white px-2.5 py-0.5 rounded-full";
                }
                if (teksAnalisis) {
                    teksAnalisis.innerText = `Alhamdulillah! Pemahaman kesiapan berkeluarga Anda meningkat dari ${pre}/100 (Pretest) menjadi ${post}/100 (Postest).`;
                }
            }

            const boxPas = document.getElementById('box-status-pasangan-realtime');
            const inpPas = document.getElementById('input-link-pasangan-dash');

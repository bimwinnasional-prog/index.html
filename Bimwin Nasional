        async function konfirmasiHadirKelasOffline(docId, statusPilihan) {
            if (!currentUser) return alert("Silakan login terlebih dahulu.");
            let alasanIzin = "";
            if (statusPilihan === "Izin / Berhalangan") {
                alasanIzin = prompt("Tuliskan alasan singkat berhalangan hadir:", "Mohon izin berhalangan hadir") || "Izin";
            }

            try {
                const docRef = db.collection("kelas_offline").doc(docId);
                const snap = await docRef.get();
                if (!snap.exists) return alert("Jadwal kelas tidak ditemukan.");

                const dataKelas = snap.data();
                const mapKonfirmasi = dataKelas.konfirmasiPeserta || {};
                mapKonfirmasi[currentUser.username] = {
                    username: currentUser.username,
                    nama: currentUser.nama,
                    nik: currentUser.nik || "-",
                    noWa: currentUser.noWa || "-",
                    status: statusPilihan,
                    catatan: alasanIzin,
                    waktuUpdate: getTanggalRealtimeIndonesia()
                };

                await docRef.set({ konfirmasiPeserta: mapKonfirmasi }, { merge: true });
                await muatKelasOfflinePeserta();
                alert(`Konfirmasi kehadiran Anda (${statusPilihan}) berhasil dikirim ke Fasilitator ${currentUser.kua}!`);
            } catch (err) {
                alert("Gagal menyimpan konfirmasi kehadiran: " + err.message);
            }
        }

        async function sahkanKehadiranOfflineOlehFasilitator(usernamePeserta) {
            if (!usernamePeserta) return;
            try {
                const uDoc = await db.collection("users").doc(usernamePeserta).get();
                const pDoc = await db.collection("progress").doc(usernamePeserta).get();
                const uData = uDoc.exists ? uDoc.data() : {};
                const pData = pDoc.exists ? pDoc.data() : {};
                const maxMod = getIdModulMaksimal();
                const tuntasMOOC = !!(uData.pasanganUsername) && (pData.skorPretest !== null && pData.skorPretest !== undefined) && ((pData.modulAktif || 1) > maxMod) && (pData.skorPostest !== null && pData.skorPostest !== undefined);

                if (!tuntasMOOC) {
                    return alert(`VERIFIKASI DITOLAK:\n\nPeserta "${uData.nama || usernamePeserta}" belum menyelesaikan seluruh tahapan MOOC (Wajib Sinkron Pasangan, Pretest, 5 Modul, dan Postest).\n\nFasilitator hanya dapat memverifikasi peserta yang telah menyelesaikan MOOC.`);
                }

                await db.collection("users").doc(usernamePeserta).set({
                    kehadiranTatapMuka: "Hadir Lengkap",
                    validasiFasilitator: true
                }, { merge: true });
                loadDataFasilitator();
                alert(`Kehadiran kelas & verifikasi kelulusan peserta (${uData.nama || usernamePeserta}) berhasil disahkan! Keempat dokumen peserta kini telah terbuka.`);
            } catch (err) {
                alert("Gagal mengesahkan kehadiran: " + err.message);
            }
        }


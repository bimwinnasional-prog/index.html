            const kuisAwal = [
                { q: `Pertanyaan evaluasi 1 untuk Modul ${idBaru}...`, opt: ["Pilihan A", "Pilihan B", "Pilihan C", "Pilihan D"], ans: 0 },
                { q: `Pertanyaan evaluasi 2 untuk Modul ${idBaru}...`, opt: ["Pilihan A", "Pilihan B", "Pilihan C", "Pilihan D"], ans: 0 },
                { q: `Pertanyaan evaluasi 3 untuk Modul ${idBaru}...`, opt: ["Pilihan A", "Pilihan B", "Pilihan C", "Pilihan D"], ans: 0 },
                { q: `Pertanyaan evaluasi 4 untuk Modul ${idBaru}...`, opt: ["Pilihan A", "Pilihan B", "Pilihan C", "Pilihan D"], ans: 0 },
                { q: `Pertanyaan evaluasi 5 untuk Modul ${idBaru}...`, opt: ["Pilihan A", "Pilihan B", "Pilihan C", "Pilihan D"], ans: 0 }
            ];

            modulInfoDefault[idBaru] = { id: idBaru, judul: judulKartu, desc: descKartu };

                new QRCode(stage, { text: teksUrl, width: 90, height: 90, colorDark: "#0b6623", colorLight: "#ffffff", correctLevel: QRCode.CorrectLevel.M });
                setTimeout(() => {
                    const canvas = stage.querySelector('canvas');
                    const img = stage.querySelector('img');
                    if (canvas) resolve(canvas.toDataURL("image/png"));
                    else if (img && img.src) resolve(img.src);
                    else resolve(`https://api.qrserver.com/v1/create-qr-code/?size=90x90&data=${encodeURIComponent(teksUrl)}`);
                }, 180);
            });
        }


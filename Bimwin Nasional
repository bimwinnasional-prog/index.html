            const lamaHaid = parseInt(document.getElementById('haid-lama')?.value || "7", 10) || 7;

            const tglPertama = new Date(tglMulaiStr);
            const tambahHari = (d, n) => {
                const c = new Date(d.getTime());
                c.setDate(c.getDate() + n);
                return c.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
            };

            const tglSuciMandWajib = tambahHari(tglPertama, lamaHaid);
            const hariOvulasi = siklus - 14;
            const suburMulai = tambahHari(tglPertama, hariOvulasi - 3);
            const suburAkhir = tambahHari(tglPertama, hariOvulasi + 1);
            const puncakOvulasi = tambahHari(tglPertama, hariOvulasi);
            const haidBerikutnya = tambahHari(tglPertama, siklus);


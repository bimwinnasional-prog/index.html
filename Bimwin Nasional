                </div>
            </div>
            <span id="badge-jumlah-kua-beranda" class="text-[10px] font-bold bg-emerald-50 dark:bg-gray-700 text-kemenag-teal dark:text-emerald-300 px-2.5 py-1 rounded-full shrink-0">16 KUA</span>

            <!-- URUTAN MENU BERANDA UTAMA SESUAI INSTRUKSI -->
            <div id="menu-utama-dropdown" class="hidden absolute left-0 top-14 w-[calc(100vw-1.5rem)] sm:w-72 bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border-2 border-kemenag-teal z-50 p-2 space-y-1 text-xs sm:text-sm">
                <button type="button" onclick="bukaSeksiBerandaUtama('seksi-utama-tentang')" class="w-full text-left px-3.5 py-2.5 rounded-xl font-bold hover:bg-emerald-50 dark:hover:bg-gray-700 flex items-center justify-start gap-2.5 transition">
                    <i class="fas fa-book-reader text-kemenag-teal w-5 text-center shrink-0"></i> <span class="text-left">Tentang Aplikasi</span>
                </button>

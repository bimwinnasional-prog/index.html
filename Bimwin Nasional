        function ubahOpsiSoalAdmin(idx, nilaiTeks) {
            const arrOpsi = nilaiTeks.split("|").map(s => s.trim()).filter(s => s !== "");
            kuisEditorSementara[idx].opt = arrOpsi.length > 0 ? arrOpsi : ["Opsi A", "Opsi B"];
            if (kuisEditorSementara[idx].ans >= kuisEditorSementara[idx].opt.length) kuisEditorSementara[idx].ans = 0;
        }


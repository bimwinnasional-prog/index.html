            document.getElementById('lms-edit-judul-kartu').value = modulInfoDefault[idMod]?.judul || '';
            document.getElementById('lms-edit-desc-kartu').value = modulInfoDefault[idMod]?.desc || '';
            document.getElementById('lms-edit-link-drive').value = linkDriveMateri[idMod] || '';
            document.getElementById('lms-edit-link-video').value = linkVideoModul[idMod] || '';
            document.getElementById('lms-edit-judul-materi').value = dbMateri[idMod]?.judul || '';
            document.getElementById('lms-edit-konten-materi').value = (dbMateri[idMod]?.konten || '').trim();

            kuisEditorSementara = JSON.parse(JSON.stringify(dbKuis[idMod] || []));
            renderDaftarSoalEditorAdmin();
        }


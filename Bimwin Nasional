                    }
                    if (doc.id === "postest_config" && Array.isArray(d.kuis) && d.kuis.length > 0) {
                        dbPostest = d.kuis;
                        return;
                    }
                    if (doc.id === "kecocokan_config" && Array.isArray(d.kuis) && d.kuis.length > 0) {
                        daftar10SoalKecocokan = d.kuis.map((item, idx) => ({

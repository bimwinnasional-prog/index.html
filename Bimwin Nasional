        let cacheKelasOfflineFas = [];
        async function simpanKelasOfflineFasilitator(e) {
            e.preventDefault();
            if (!currentUser) return;
            const editId = document.getElementById('offline-edit-id').value.trim();
            const judul = document.getElementById('offline-judul').value.trim();
            const lokasi = document.getElementById('offline-lokasi').value.trim();
            const kua = currentUser.kua || 'Semua KUA';
            const tanggal = document.getElementById('offline-tanggal').value;
            const waktu = document.getElementById('offline-waktu').value;
            const catatan = document.getElementById('offline-catatan').value.trim();

            const payload = {
                judul, lokasi, kua, tanggal, waktu, catatan,
                namaFasilitator: (currentUser.nama || 'Fasilitator').replace(' / Penghulu', ''),
                usernameFasilitator: currentUser.username,
                timestamp: Date.now()
            };

            try {
                if (editId) {
                    await db.collection("kelas_offline").doc(editId).update(payload);
                    alert("Jadwal Kelas Offline berhasil diperbarui!");
                } else {
                    await db.collection("kelas_offline").add({ ...payload, konfirmasiPeserta: {} });
                    alert("Kelas Offline berhasil dijadwalkan dan ditautkan ke Dasbor Peserta!");
                }
                resetFormKelasOffline();
                muatKelasOfflineFasilitator();
            } catch (err) {
                alert("Gagal menyimpan jadwal kelas offline: " + err.message);
            }
        }

        function resetFormKelasOffline() {
            const form = document.getElementById('form-kelas-offline-fas');
            if (form) form.reset();
            document.getElementById('offline-edit-id').value = '';
            if (currentUser) document.getElementById('offline-kua-target').value = currentUser.kua || 'Semua KUA';
            document.getElementById('btn-submit-offline-fas').innerHTML = `<i class="fas fa-calendar-check mr-1"></i> Jadwalkan Kelas Offline ke Peserta`;

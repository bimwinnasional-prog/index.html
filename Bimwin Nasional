        async function cetakUlangSertifikatOlehAdmin(usernameTarget) {
            const p = semuaPesertaAdmin.find(x => x.username === usernameTarget);
            if (!p) return alert("Data peserta tidak ditemukan.");

            try {
                const progDoc = await db.collection("progress").doc(usernameTarget).get();
                const progData = progDoc.exists ? progDoc.data() : {};
                const idMaxModul = getIdModulMaksimal();
                const sudahSinkronPasangan = !!(p.pasanganUsername && p.pasanganUsername.trim() !== "");
                const sudahPretest = progData.skorPretest !== null && progData.skorPretest !== undefined;
                const sudahSelesaiModul = (progData.modulAktif || 1) > idMaxModul;
                const sudahPostest = progData.skorPostest !== null && progData.skorPostest !== undefined;
                const sudahIsiIKM = !!p.sudahIsiIKM;
                const sudahVerifikasiFas = p.validasiFasilitator === true;

                if (!sudahSinkronPasangan || !sudahPretest || !sudahSelesaiModul || !sudahPostest || !sudahIsiIKM || !sudahVerifikasiFas) {
                    return alert(
                        `SERTIFIKAT BELUM DAPAT DIUNDUH\n\n` +
                        `Peserta atas nama "${p.nama}" (${p.username}) belum memenuhi seluruh syarat kelulusan:\n` +
                        `1. Sinkronisasi Akun Pasangan: ${sudahSinkronPasangan ? '✅ Terhubung (' + p.pasanganUsername + ')' : '❌ Belum ditautkan'}\n` +
                        `2. Latihan Pretest (5 Soal): ${sudahPretest ? '✅ Selesai (' + progData.skorPretest + '/100)' : '❌ Belum dikerjakan'}\n` +
                        `3. Seluruh Modul & Kuis: ${sudahSelesaiModul ? '✅ Selesai Tuntas' : '❌ Belum selesai'}\n` +
                        `4. Evaluasi Postest (5 Soal): ${sudahPostest ? '✅ Selesai (' + progData.skorPostest + '/100)' : '❌ Belum dikerjakan'}\n` +
                        `5. Survei Kepuasan (IKM): ${sudahIsiIKM ? '✅ Selesai (' + (p.nilaiIKM || 5) + ' Bintang)' : '❌ Belum diisi'}\n` +
                        `6. Verifikasi Fasilitator KUA: ${sudahVerifikasiFas ? '✅ Terverifikasi' : '❌ Belum diverifikasi Fasilitator'}`
                    );
                }

                const cadanganUser = currentUser;
                const cadanganModul = modulAktifGlobal;
                currentUser = { ...p, skorPretest: progData.skorPretest, skorPostest: progData.skorPostest, sudahIsiIKM: true, validasiFasilitator: true };
                modulAktifGlobal = idMaxModul + 1;
                await downloadSertifikatAsliInternal();
                currentUser = cadanganUser;
                modulAktifGlobal = cadanganModul;
                catatLogAktivitasAdmin(`Mencetak sertifikat peserta lulus: ${p.nama} (${p.kodeSertifikat})`);
                loadDataAdmin(currentUser);
            } catch (err) {
                alert("Gagal memvalidasi kelulusan peserta: " + err.message);
            }
        }

        let daftarPesertaFasilitator = [];
        async function loadDataFasilitator() {
            if (!currentUser) return;
            try {
                const snap = currentUser.kua
                    ? await db.collection("users").where("role", "==", "Peserta").where("kua", "==", currentUser.kua).get()
                    : await db.collection("users").where("role", "==", "Peserta").get();
                const progSnap = await db.collection("progress").get();
                const mapP = {};
                progSnap.forEach(d => mapP[d.id] = d.data());

                const maxMod = getIdModulMaksimal();
                daftarPesertaFasilitator = [];
                let jmlSiapVerif = 0;
                snap.forEach(doc => {
                    const u = doc.data();
                    const pr = mapP[u.username] || {};
                    const modAkt = pr.modulAktif || 1;
                    const sPre = pr.skorPretest !== undefined ? pr.skorPretest : null;
                    const sPost = pr.skorPostest !== undefined ? pr.skorPostest : null;
                    const sudahSinkron = !!(u.pasanganUsername && u.pasanganUsername.trim() !== "");
                    const tuntasMOOC = sudahSinkron && (sPre !== null) && (modAkt > maxMod) && (sPost !== null);
                    if (tuntasMOOC && u.validasiFasilitator !== true) jmlSiapVerif++;
                    daftarPesertaFasilitator.push({
                        ...u,
                        modulAktif: modAkt,
                        skorPretest: sPre,
                        skorPostest: sPost,
                        totalNilai: pr.totalNilai || 0,
                        tuntasMOOC: tuntasMOOC
                    });
                });
                const badgeSiap = document.getElementById('badge-jml-siap-verif-fas');
                if (badgeSiap) badgeSiap.innerText = jmlSiapVerif;
                daftarPesertaFasilitator.sort((a, b) => (b.tanggalDaftar || "").localeCompare(a.tanggalDaftar || ""));
                renderTabelFasilitator();
                muatKonsultasiFasilitator();
            } catch (e) {}
        }


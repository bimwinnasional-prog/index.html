        function renderTabelFasilitator() {
            const tbody = document.getElementById('tbody-fasilitator');
            if (!tbody) return;
            const q = (document.getElementById('cari-peserta-fasilitator')?.value || '').toLowerCase();
            const filterSt = document.getElementById('fas-filter-status-mooc')?.value || 'semua';
            const tglMulai = document.getElementById('fas-filter-tgl-mulai')?.value || '';
            const tglAkhir = document.getElementById('fas-filter-tgl-akhir')?.value || '';

            const list = daftarPesertaFasilitator.filter(p => {
                const cocokKata = !q || (p.nama || '').toLowerCase().includes(q) || (p.nik || '').includes(q) || (p.kua || '').toLowerCase().includes(q) || (p.pasanganNama || '').toLowerCase().includes(q);
                const tglP = p.tanggalDaftar || '';
                if (tglMulai && tglP < tglMulai) return false;
                if (tglAkhir && tglP > tglAkhir) return false;
                if (filterSt === 'siap_verif' && !(p.tuntasMOOC && p.validasiFasilitator !== true)) return false;
                if (filterSt === 'belum_mooc' && p.tuntasMOOC) return false;
                if (filterSt === 'terverifikasi' && p.validasiFasilitator !== true) return false;
                return cocokKata;
            });

            document.getElementById('jml-binaan-fasilitator').innerText = `${list.length} Peserta`;
            tbody.innerHTML = '';
            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-4 text-center text-gray-400 italic">Tidak ada peserta pada filter pencarian/tanggal tersebut.</td></tr>`;
                return;
            }
            const jmlModTotal = getJumlahModulTotal();
            list.forEach((p, idx) => {
                const usiaNum = Number(p.usia || 24);
                const badgeUsia = usiaNum < 19
                    ? `<span class="bg-red-100 text-red-700 px-1.5 py-0.5 rounded text-[10px] font-extrabold ml-1">${usiaNum} Thn (Dispensasi PA)</span>`
                    : `<span class="bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded text-[10px] ml-1">${usiaNum} Thn</span>`;
                const infoPas = p.pasanganUsername ? `<div class="text-[10px] text-pink-600 font-bold">💍 Pasangan: ${escapeHTML(p.pasanganNama || p.pasanganUsername)}</div>` : `<div class="text-[10px] text-red-500 font-semibold">❌ Belum Sinkron Pasangan</div>`;
                const badgeMOOC = p.tuntasMOOC
                    ? `<span class="inline-block bg-emerald-100 text-kemenag-teal px-2 py-0.5 rounded text-[10px] font-extrabold mt-0.5">✓ MOOC Tuntas (Siap Verifikasi)</span>`
                    : `<span class="inline-block bg-amber-100 text-amber-800 px-2 py-0.5 rounded text-[10px] font-bold mt-0.5">🔒 Belum Tuntas MOOC</span>`;

                const chkHtml = p.tuntasMOOC
                    ? `<input type="checkbox" id="fas-valid-${p.username}" ${p.validasiFasilitator === true ? 'checked' : ''} class="w-5 h-5 accent-emerald-600 cursor-pointer" title="Centang untuk membuka 4 dokumen kelulusan peserta">`
                    : `<input type="checkbox" id="fas-valid-${p.username}" disabled class="w-5 h-5 opacity-40 cursor-not-allowed" title="Terkunci: Peserta belum menyelesaikan MOOC"><div class="text-[9px] text-red-500 font-bold mt-0.5">Wajib Selesai MOOC</div>`;

                tbody.innerHTML += `
                    <tr>
                        <td class="p-3">${idx + 1}</td>
                        <td class="p-3 font-bold">${escapeHTML(p.nama || '-')}${badgeUsia}<div class="text-[10px] font-mono text-gray-400">${escapeHTML(p.nik || '-')}</div>${infoPas}</td>
                        <td class="p-3 font-mono text-xs">${escapeHTML(p.tanggalDaftar || '-')}</td>
                        <td class="p-3">Modul ${Math.min(jmlModTotal, p.modulAktif)}/${jmlModTotal} • <b>${Math.round(p.totalNilai)}/100</b><br>${badgeMOOC}</td>
                        <td class="p-3">
                            <select id="fas-hadir-${p.username}" class="px-2 py-1 border rounded bg-gray-50 dark:bg-gray-900 text-xs">
                                <option value="Belum Hadir" ${p.kehadiranTatapMuka === 'Belum Hadir' ? 'selected' : ''}>Belum Hadir</option>
                                <option value="Hadir Lengkap" ${p.kehadiranTatapMuka === 'Hadir Lengkap' ? 'selected' : ''}>Hadir Lengkap</option>
                                <option value="Izin / Terjadwal Ulang" ${p.kehadiranTatapMuka === 'Izin / Terjadwal Ulang' ? 'selected' : ''}>Izin / Terjadwal Ulang</option>
                            </select>
                        </td>
                        <td class="p-3">
                            <input type="text" id="fas-catatan-${p.username}" list="list-template-catatan-fas" value="${escapeHTML(p.catatanFasilitator || '')}" placeholder="Ketik/pilih catatan..." class="w-full px-2 py-1 border rounded bg-gray-50 dark:bg-gray-900 text-xs">
                        </td>
                        <td class="p-3 text-center">${chkHtml}</td>
                        <td class="p-3 text-center">
                            <button type="button" onclick="simpanVerifikasiFasilitator('${p.username}')" class="bg-kemenag-teal text-white px-3 py-1 rounded-lg text-xs font-bold shadow">Simpan</button>
                        </td>
                    </tr>`;
            });
        }

        async function verifikasiMassalPesertaTuntasMOOC() {
            const siapVerif = daftarPesertaFasilitator.filter(p => p.tuntasMOOC && p.validasiFasilitator !== true);
            if (siapVerif.length === 0) {
                return alert("Tidak ada peserta berstatus 'MOOC Tuntas' yang belum diverifikasi saat ini.");
            }
            if (!confirm(`Verifikasi sekaligus ${siapVerif.length} peserta yang sudah menyelesaikan seluruh tahapan MOOC di ${currentUser.kua}?`)) return;

            try {
                for (const p of siapVerif) {
                    await db.collection("users").doc(p.username).set({
                        kehadiranTatapMuka: "Hadir Lengkap",
                        validasiFasilitator: true,
                        catatanFasilitator: p.catatanFasilitator || "Telah mengikuti bimbingan dan siap membina keluarga Sakinah."
                    }, { merge: true });
                }
                await loadDataFasilitator();
                alert(`Berhasil! Sebanyak ${siapVerif.length} peserta yang telah selesai MOOC kini resmi terverifikasi lulus.`);
            } catch (err) {
                alert("Gagal melakukan verifikasi massal: " + err.message);
            }
        }

        async function simpanVerifikasiFasilitator(uname) {
            const item = daftarPesertaFasilitator.find(x => x.username === uname);
            const hadir = document.getElementById(`fas-hadir-${uname}`).value;
            const catatan = document.getElementById(`fas-catatan-${uname}`).value.trim();
            const chkEl = document.getElementById(`fas-valid-${uname}`);
            let valid = chkEl ? chkEl.checked : false;

            if (valid && item && !item.tuntasMOOC) {
                if (chkEl) chkEl.checked = false;
                return alert("Fasilitator hanya dapat memverifikasi peserta setelah peserta menyelesaikan seluruh tahapan MOOC (Sinkron Pasangan, Pretest, 5 Modul, dan Postest).");
            }

            await db.collection("users").doc(uname).set({
                kehadiranTatapMuka: hadir, catatanFasilitator: catatan, validasiFasilitator: valid
            }, { merge: true });
            await loadDataFasilitator();
            alert(`Data bimbingan peserta berhasil disimpan! Status kunci 4 dokumen kelulusan: ${valid ? 'TERBUKA (Terverifikasi)' : 'TERKUNCI'}`);
        }

        async function muatKonsultasiFasilitator() {
            const box = document.getElementById('list-konsultasi-fasilitator');
            const badgeBelum = document.getElementById('badge-konsul-belum-dijawab-fas');
            if (!box) return;
            try {
                const snap = await db.collection("konsultasi").get();
                if (snap.empty) {
                    if (badgeBelum) badgeBelum.innerText = "0 Menunggu";
                    box.innerHTML = `<p class="text-gray-400 italic">Belum ada pertanyaan konsultasi.</p>`;
                    return;
                }
                const arrK = [];
                let belumJawabCount = 0;
                snap.forEach(doc => {
                    const dt = doc.data();
                    if (!currentUser.kua || dt.kua === currentUser.kua) {
                        arrK.push({ id: doc.id, ...dt });
                        if (!dt.jawaban) belumJawabCount++;
                    }
                });
                if (badgeBelum) badgeBelum.innerText = `${belumJawabCount} Menunggu`;
                arrK.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
                if (arrK.length === 0) { box.innerHTML = `<p class="text-gray-400 italic">Belum ada pertanyaan konsultasi di wilayah ${currentUser.kua}.</p>`; return; }
                box.innerHTML = '';

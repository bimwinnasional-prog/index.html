            try {
                const docLama = await db.collection("users").doc(unameLama).get();
                if (!docLama.exists) throw new Error("Akun lama tidak ditemukan.");
                const dataFull = docLama.data();
                const passHash = await hashPasswordSHA256(passBaru);

                if (unameBaru !== unameLama) {
                    if ((await db.collection("users").doc(unameBaru).get()).exists) {
                        alert("Username baru tersebut sudah dipakai!");
                        btn.innerText = "Simpan Kredensial Akun"; btn.disabled = false; return;
                    }
                    await db.collection("users").doc(unameBaru).set({ ...dataFull, nama: namaBaru, username: unameBaru, password: passBaru, passwordHash: passHash });
                    await db.collection("users").doc(unameLama).delete();
                } else {
                    await db.collection("users").doc(unameLama).update({ nama: namaBaru, password: passBaru, passwordHash: passHash });

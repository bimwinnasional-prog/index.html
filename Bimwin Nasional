async function hitungKesiapanStunting(simpanKeDb) {
            const bb = parseFloat(document.getElementById('stunting-bb')?.value || "52") || 52;
            const tbCm = parseFloat(document.getElementById('stunting-tb')?.value || "158") || 158;
            const lila = parseFloat(document.getElementById('stunting-lila')?.value || "24.5") || 24.5;
            const hb = parseFloat(document.getElementById('stunting-hb')?.value || "12.5") || 12.5;
            const box = document.getElementById('hasil-stunting-box');
            if (!box) return;

            const tbM = tbCm / 100;
            const imt = +(bb / (tbM * tbM)).toFixed(1);
            let katImt = "Normal / Ideal (18,5 sampai 24,9)";
            if (imt < 18.5) katImt = "Kurus / Kurang Gizi (Di bawah 18,5)";
            else if (imt >= 25) katImt = "Gemuk / Berlebih (25,0 ke atas)";

            const risikoKEK = lila < 23.5;
            const risikoAnemia = hb < 12.0;
            const statusUtama = (risikoKEK || risikoAnemia || imt < 18.5)
                ? "Risiko KEK / Anemia (Perlu Suplementasi Gizi)"

                if (Number(p.usia || 24) < 19) giziCount["Usia <19 Thn"]++;

                const pend = p.pendidikan || "SMA/SMK/MA";
                if (pend.includes("S1")) eduCount["Sarjana"]++;
                else if (pend.includes("Diploma")) eduCount["Diploma"]++;
                else if (pend.includes("S2")) eduCount["Pascasarjana"]++;

                        }));
                        return;
                    }
                    if (!doc.id.startsWith("modul_")) return;
                    const idMod = parseInt(doc.id.replace("modul_", ""), 10);
                    if (isNaN(idMod)) return;
                    if (d.dihapus === true) {

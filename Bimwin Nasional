        function buatQRCodeTajamKeKontainer(containerEl, teksUrl, ukuranPx = 60) {
            return new Promise((resolve) => {
                if (!containerEl) return resolve();
                containerEl.innerHTML = '';
                try {
                    new QRCode(containerEl, {
                        text: String(teksUrl || "BIMWIN-JEPARA"),
                        width: ukuranPx,
                        height: ukuranPx,
                        colorDark: "#0b6623",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.M
                    });
                } catch (e) {
                    return resolve();
                }
                setTimeout(() => {
                    const canvas = containerEl.querySelector('canvas');
                    const img = containerEl.querySelector('img');
                    if (canvas) {
                        try {
                            const dataUrl = canvas.toDataURL("image/png");
                            if (img) {
                                img.onload = () => resolve();
                                img.onerror = () => resolve();
                                img.src = dataUrl;
                                img.style.display = "block";
                                img.style.width = ukuranPx + "px";
                                img.style.height = ukuranPx + "px";
                                canvas.style.display = "none";
                                return;
                            }
                        } catch (e) {}
                    }
                    resolve();
                }, 120);
            });
        }


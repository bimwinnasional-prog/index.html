                const header = "Username,Nama,Usia,NIK,KUA,Pasangan,Status_Gizi,No_Sertifikat,Tanggal_Daftar,Nilai_IKM,Alasan_IKM\n";
                const rows = dataBackup.users.filter(u => u.role === 'Peserta').map(u => `"${u.username}","${u.nama}","${u.usia || ''}","${u.nik}","${u.kua}","${u.pasanganUsername || ''}","${u.statusGiziStunting || ''}","${u.kodeSertifikat}","${u.tanggalDaftar}","${u.nilaiIKM || ''}","${(u.ulasanIKM || '').replace(/"/g, '""')}"`).join("\n");
                const blob = new Blob([header + rows], { type: "text/csv;charset=utf-8;" });
                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = `Backup_Peserta_Bimwin_${new Date().toISOString().slice(0,10)}.csv`;
                a.click();
            }
        }


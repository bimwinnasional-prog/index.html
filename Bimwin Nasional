        function formatLinkYoutubeEmbed(url) {
            if (!url) return "";
            let cleanUrl = url.trim();
            if (cleanUrl.includes("youtube.com/embed/")) return cleanUrl;
            let videoId = "";
            if (cleanUrl.includes("youtu.be/")) videoId = cleanUrl.split("youtu.be/")[1].split("?")[0];
            else if (cleanUrl.includes("youtube.com/shorts/")) videoId = cleanUrl.split("youtube.com/shorts/")[1].split("?")[0];
            else if (cleanUrl.includes("v=")) videoId = cleanUrl.split("v=")[1].split("&")[0];
            return videoId ? `https://www.youtube.com/embed/${videoId}?enablejsapi=1&rel=0` : cleanUrl;
        }

        function hitungPasanganUnikTersinkronisasi(daftarUser, modeKelompok = 'kua') {
            const setPasanganUnik = new Set();
            const mapPerKelompok = {};
            if (modeKelompok === 'kua') {
                daftarKuaResmi.forEach(k => mapPerKelompok[k] = 0);
            } else if (currentUser && currentUser.kua) {
                (desaPerKuaJepara[currentUser.kua] || []).forEach(d => mapPerKelompok[d.trim()] = 0);
                mapPerKelompok["Wilayah KUA"] = 0;
            }

            daftarUser.forEach(u => {
                const u1 = (u.username || '').trim().toLowerCase();
                const u2 = (u.pasanganUsername || '').trim().toLowerCase();
                if (!u1 || !u2 || u1 === u2) return;
                const pairKey = [u1, u2].sort().join('__');
                if (!setPasanganUnik.has(pairKey)) {
                    setPasanganUnik.add(pairKey);
                    if (modeKelompok === 'kua') {
                        if (mapPerKelompok[u.kua] !== undefined) mapPerKelompok[u.kua]++;
                    } else {
                        const nd = ekstrakDesaDariAlamat(u);
                        mapPerKelompok[nd] = (mapPerKelompok[nd] || 0) + 1;
                    }
                }
            });

            return { totalPasangan: setPasanganUnik.size, statsPasangan: mapPerKelompok };
        }

        async function muatKonfigurasiLMSDariFirestore() {
            try {

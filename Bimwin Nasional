                if (boxMateri) boxMateri.classList.add('hidden');
                if (petunjuk) petunjuk.innerHTML = "Kelola skenario Kuis Kecocokan Pasangan (Pisahkan pilihan sikap dengan tanda <b>|</b> ).";
                kuisEditorSementara = daftar10SoalKecocokan.map(s => ({
                    q: s.tanya,
                    opt: [...s.opsi],
                    ans: 0
                }));
                renderDaftarSoalEditorAdmin();
                return;
            }

            if (idMod === 'pretest' || idMod === 'postest') {
                if (boxMateri) boxMateri.classList.add('hidden');
                if (petunjuk) petunjuk.innerHTML = "Pisahkan pilihan jawaban dengan tanda garis vertikal <b>|</b> dan pilih kunci jawaban benar.";
                kuisEditorSementara = JSON.parse(JSON.stringify(idMod === 'pretest' ? dbPretest : dbPostest));
                renderDaftarSoalEditorAdmin();
                return;
            }

            if (boxMateri) boxMateri.classList.remove('hidden');
            if (petunjuk) petunjuk.innerHTML = "Pisahkan pilihan jawaban dengan tanda garis vertikal <b>|</b> dan pilih kunci jawaban benar.";

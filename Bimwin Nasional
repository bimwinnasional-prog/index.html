        function pilihModulAdminLMS(idMod) {
            const boxMateri = document.getElementById('lms-box-materi-modul');
            const petunjuk = document.getElementById('lms-petunjuk-editor-soal');
            document.getElementById('lms-admin-id-modul').value = idMod;

                    box.innerHTML += `
                        <div class="pt-3 first:pt-0 space-y-2">
                            <div class="flex justify-between"><span class="font-bold text-kemenag-teal">${escapeHTML(k.nama)} (${escapeHTML(k.kua)}) — ${escapeHTML(k.topik)}</span><span class="text-[10px] text-gray-400">${escapeHTML(k.tanggal)}</span></div>

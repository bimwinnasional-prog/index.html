        function hitungUsiaOtomatisDariTTL(teksTTL, targetInputId = 'reg-usia', targetAlertId = 'alert-usia-dini-register') {
            const inputUsia = document.getElementById(targetInputId);
            const alertUsia = document.getElementById(targetAlertId);
            if (!inputUsia || !teksTTL) return;

            const teks = teksTTL.toLowerCase().trim();
            const bagianTanggal = teks.includes(',') ? teks.split(',').slice(1).join(' ').trim() : teks;

            const mapBulanIndo = {
                januari: 0, jan: 0, februari: 1, pebruari: 1, feb: 1, maret: 2, mar: 2,
                april: 3, apr: 3, mei: 4, juni: 5, jun: 5, juli: 6, jul: 6,
                agustus: 7, agu: 7, agt: 7, september: 8, sep: 8, sept: 8,
                oktober: 9, okt: 9, november: 10, nopember: 10, nov: 10, desember: 11, des: 11
            };

            let tgl = null, bln = null, thn = null;

            const regexNamaBulan = /(\d{1,2})\s+([a-zA-Z]+)\s+(\d{4})/;
            const matchNama = bagianTanggal.match(regexNamaBulan);
            if (matchNama) {
                tgl = parseInt(matchNama[1], 10);
                const namaB = matchNama[2].toLowerCase();
                if (mapBulanIndo[namaB] !== undefined) bln = mapBulanIndo[namaB];
                thn = parseInt(matchNama[3], 10);
            }

            if (thn === null) {
                const regexAngka = /(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/;
                const matchAngka = bagianTanggal.match(regexAngka);
                if (matchAngka) {
                    tgl = parseInt(matchAngka[1], 10);
                    bln = parseInt(matchAngka[2], 10) - 1;
                    thn = parseInt(matchAngka[3], 10);
                }
            }

            if (thn === null) {
                const matchTahunSaja = bagianTanggal.match(/\b(19\d{2}|20\d{2})\b/);
                if (matchTahunSaja) {
                    thn = parseInt(matchTahunSaja[1], 10);
                    bln = 0; tgl = 1;
                }
            }

            if (thn !== null && thn >= 1930 && thn <= new Date().getFullYear()) {
                const hariIni = new Date();
                let umur = hariIni.getFullYear() - thn;
                if (bln !== null && tgl !== null) {
                    const selisihBulan = hariIni.getMonth() - bln;
                    if (selisihBulan < 0 || (selisihBulan === 0 && hariIni.getDate() < tgl)) {
                        umur--;
                    }
                }
                if (umur > 0 && umur < 100) {
                    inputUsia.value = umur;
                    if (alertUsia) {
                        alertUsia.classList.toggle('hidden', umur >= 19);
                    }
                }
            }
        }


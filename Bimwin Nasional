            semuaPesertaAdmin.forEach(p => {
                if (p.nilaiIKM) {
                    totalSkorIKM += Number(p.nilaiIKM); jmlRespondenIKM++;
                    if (p.nilaiIKM === 5) bintangCount["5 Bintang"]++;
                    else if (p.nilaiIKM === 4) bintangCount["4 Bintang"]++;
                    else if (p.nilaiIKM === 3) bintangCount["3 Bintang"]++;
                    else bintangCount["1-2 Bintang"]++;
